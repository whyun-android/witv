<?xml version="1.0" encoding="utf-8"?>
<!-- 节目单里的一行：只在顶部画一条分隔线。
     面板是半透明的，视频会盖过底色深浅，分栏只能靠这条线。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/witvEpgDivider" />
        </shape>
    </item>
</layer-list>
