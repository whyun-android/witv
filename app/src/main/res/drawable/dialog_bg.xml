<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗底：跟随主题的卡片色，四周留 inset 让系统弹窗动画和阴影正常 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/witvCardBg" />
        <stroke android:width="1dp" android:color="?attr/witvCardStroke" />
        <corners android:radius="12dp" />
    </shape>
</inset>
