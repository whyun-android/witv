<?xml version="1.0" encoding="utf-8"?>
<!-- 频道菜单（分组栏）行底：焦点态必须比「当前选中」醒目，遥控器下才看得出光标在哪。
     频道栏的行底见 channel_menu_row_bg（多一个门牌号码块），分组栏不需要那一块。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/witvFocusBg" />
            <corners android:radius="?attr/witvMenuRowRadius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/witvSelectedBg" />
            <corners android:radius="?attr/witvMenuRowRadius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="?attr/witvMenuRowRadius" />
        </shape>
    </item>
</selector>
