<?xml version="1.0" encoding="utf-8"?>
<!-- 设置面板里的输入框：未聚焦也要看得出是一个框，聚焦时白描边，与其他控件的焦点一致 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/witvCardBg" />
            <stroke
                android:width="2dp"
                android:color="?attr/witvTextPrimary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/witvCardBg" />
            <stroke
                android:width="1dp"
                android:color="?attr/witvCardStroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
