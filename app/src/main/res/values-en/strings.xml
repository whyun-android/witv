    <string name="settings_group_decoder">Decoder</string>
    <string name="decoder_mode_auto">Hardware first (recommended)</string>
    <string name="decoder_mode_auto_desc">Use hardware decoding; automatically fall back to software for codecs the box can\'t handle (e.g. MPEG-2 video or MP2 audio common in multicast)</string>
    <string name="decoder_mode_software_audio">Software audio + hardware video</string>
    <string name="decoder_mode_software_audio_desc">Decode audio with FFmpeg to bypass Dolby passthrough while video stays on hardware. For devices where Dolby audio is silent but video plays fine</string>
    <string name="decoder_mode_prefer_software">Software first</string>
    <string name="decoder_mode_prefer_software_desc">Prefer FFmpeg software decoding for both audio and video. High CPU usage; 1080p may stutter on low-end boxes</string>
    <string name="decoder_mode_hardware_only">Hardware only</string>
    <string name="decoder_mode_hardware_only_desc">Never load the software decoder. For troubleshooting software-decoder issues or very low-end CPUs</string>
