<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/epg_url"
        android:textColor="?attr/witvTextSecondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/epg_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/tv_input_bg"
        android:hint="http://example.com/epg.xml"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="?attr/witvTextPrimary"
        android:textColorHint="?attr/witvTextSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_save_epg"
        style="@style/TvActionButton.Compact.Primary"
        android:layout_marginTop="10dp"
        android:text="@string/save_epg_settings"
        android:textColor="?attr/witvTextPrimary" />

    <Button
        android:id="@+id/btn_reload_epg"
        style="@style/TvActionButton.Compact"
        android:layout_marginTop="8dp"
        android:text="@string/reload_epg_data"
        android:textColor="?attr/witvTextPrimary" />

</LinearLayout>
