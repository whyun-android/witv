<?xml version="1.0" encoding="utf-8"?>
<!-- 节目单里的一行。电视包装主题的「当前节目」会把整行铺上底色，再加牌子与进度条；
     标准主题只加粗、时间变色，所以进度条那一行留着不显示（见 witvEpgCurrentStyle）。
     稿里当前节目块比列表左右各宽出一截（margin:0 -16px; padding:16px）：节目单列表本身
     往两侧外扩 12dp（见 activity_player 的 channel_list_epg_list），每行再收回 12dp 内边距，
     这样块的圆角和左右留白都落在列表范围内，不会被父容器裁掉。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/epg_program_row_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/epg_program_time"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/witvTextSecondary"
            android:textSize="17sp" />

        <!-- 稿里时间列 90px 宽、与节目名之间 gap 24px（＝60dp + 16dp） -->
        <TextView
            android:id="@+id/epg_program_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/witvTextPrimary"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/epg_program_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 稿里「正在播出」牌在第二行打头、与节目名左对齐（padding-left:114px ＝ 60dp + 16dp），
             进度条跟在牌子后面 -->
        <View
            android:layout_width="76dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/epg_program_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/live_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="@string/epg_live_badge"
            android:textColor="?attr/witvOnLive"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 圆角轨道；填充段靠 clipToOutline 裁成圆头（代码里打开） -->
        <LinearLayout
            android:id="@+id/epg_program_progress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/epg_progress_track_bg"
            android:orientation="horizontal">

            <View
                android:id="@+id/epg_program_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="?attr/witvAccent" />

            <View
                android:id="@+id/epg_program_progress_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
