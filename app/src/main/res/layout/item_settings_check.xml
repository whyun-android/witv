<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <CheckBox
        android:id="@+id/check_option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/channel_item_bg"
        android:focusable="true"
        android:minHeight="48dp"
        android:paddingVertical="8dp"
        android:paddingEnd="12dp"
        android:textColor="?attr/witvTextPrimary"
        android:textSize="16sp"
        android:buttonTint="@color/settings_check_tint" />

    <TextView
        android:id="@+id/check_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:textColor="?attr/witvTextSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
