<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/web_hint_qr"
        android:layout_width="@dimen/settings_web_qr_size"
        android:layout_height="@dimen/settings_web_qr_size"
        android:background="@android:color/white"
        android:contentDescription="@string/web_address_qr_desc"
        android:padding="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/web_hint_qr_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/web_address_qr_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
